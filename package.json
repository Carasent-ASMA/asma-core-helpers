{
    "name": "asma-core-helpers",
    "version": "0.4.2",
    "description": "Core helper utilities for ASMA applications",
    "files": [
        "lib/**/*",
        "src/**/*"
    ],
    "types": "lib/index.d.ts",
    "type": "module",
    "exports": {
        ".": "./lib/index.js",
        "./lib": "./lib/index.js",
        "./urql": {
            "types": "./lib/helpers/urql.d.ts",
            "default": "./lib/helpers/urql.js"
        },
        "./collaboration": {
            "types": "./lib/collaboration/index.d.ts",
            "default": "./lib/collaboration/index.js"
        }
    },
    "scripts": {
        "build": "pnpm ts:check",
        "ts:check": "tsc",
        "test": "node --import tsx --test \"src/**/*.test.ts\""
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Carasent-ASMA/asma-core-helpers.git"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@openreplay/tracker": "^16.4.10",
        "asma-qiankun-react-loader": "^0.8.2",
        "asma-types": "^2.10.0",
        "history": "^5.3.0",
        "lefthook": "^2.1.1",
        "tsx": "^4.23.0",
        "typescript": "7.0.2"
    },
    "dependencies": {
        "@0no-co/graphql.web": "^1.0.9",
        "@urql/core": "^6.0.3",
        "@urql/exchange-auth": "^3.0.0",
        "arktype": "^2.2.3",
        "asma-event-bus": "^0.7.27",
        "buffer": "^6.0.3",
        "idb-keyval": "^6.2.1",
        "mobx": "^6.12.3",
        "mobx-state-tree": "^7.0.2",
        "wonka": "^6.3.4"
    }
}